# Check that llvm-bolt can processes bzip2 binary for aarch64.
REQUIRES: local-release-artifacts

RUN: BZIP2_BIN=$(%PYTHON3% %release-prepare-helper% \
RUN:   --release-root %release-root% \
RUN:   --name bzip2 \
RUN:   --version 1.0.8 \
RUN:   --output-dir %t.release) && \
RUN: llvm-bolt "${BZIP2_BIN}" -o %t |& FileCheck %s

# Check that llvm-bolt can processes bzip2 binary for aarch64 with relocations enabled.
CHECK: BOLT-INFO: Target architecture: aarch64
BOLT-INFO: setting _end to {{0x[0-9a-f]+}}
CHECK-NOT: BOLT-ERROR
